filters:
  and:
    - file.ext != "base"
views:
  - type: list
    name: list
    filters:
      and:
        - file.inFolder("journal")
        - file.name != "index"
    order:
      - published
      - file.name
    sort:
      - property: published
        direction: DESC
    columnSize:
      note.published: 153
      file.name: 252
    separator: " "
